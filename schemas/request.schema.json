{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A7m0spHere/cdu-library-book-survey/schemas/request.schema.json",
  "title": "CDU OPAC survey collection request",
  "description": "Input for the evidence collector. It does not request or encode final academic recommendations.",
  "type": "object",
  "required": ["profile", "keywords"],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "type": "object",
      "description": "Context passed through to the Agent and survey output.",
      "additionalProperties": false,
      "properties": {
        "school": {
          "type": "string",
          "minLength": 1
        },
        "major": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "enum": ["课程学习", "考研", "科研入门", "兴趣拓展", "职业技能"]
        },
        "network": {
          "type": "string",
          "enum": ["校园网", "学校 VPN", "校外未连接 VPN", "未知"]
        },
        "output_depth": {
          "type": "string",
          "enum": ["brief", "normal", "deep"]
        }
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_results_per_keyword": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 50
    },
    "max_records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 50
    },
    "max_location_requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500,
      "default": 30
    },
    "include_shelf_locations": {
      "type": "boolean",
      "default": true
    },
    "use_cache": {
      "type": "boolean",
      "default": true
    },
    "refresh": {
      "type": "boolean",
      "default": false
    },
    "request_delay_seconds": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 10,
      "default": 0.8
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "default": 2
    }
  }
}
